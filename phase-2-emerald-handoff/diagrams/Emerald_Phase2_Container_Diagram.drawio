<mxfile host="Electron" agent="Claude">
  <diagram name="Container Diagram" id="container-diagram">
    <mxGraphModel dx="1885" dy="1216" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#3399FF;" value="C4 Container Diagram" vertex="1">
          <mxGeometry height="30" width="440" x="280" y="15" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;fontColor=#555555;" value="Post Office Online Shipping System — Phase 2 (Emerald)" vertex="1">
          <mxGeometry height="22" width="540" x="230" y="45" as="geometry" />
        </mxCell>
        <mxCell id="customer" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#052a4f;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#cfe1f5&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;User who sends&lt;br&gt;and tracks parcels" vertex="1">
          <mxGeometry height="130" width="140" x="430" y="100" as="geometry" />
        </mxCell>
        <mxCell id="web" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0a4680;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;Web Application&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#cfe1f5&quot;&gt;[Container: React 19 (Create React App, plain CSS)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Browser-based UI for customers to login,&lt;br&gt;create shipments (zip-code auto-fill), pay,&lt;br&gt;track parcels, view history.&lt;br&gt;Admin pages show hard-coded mock data only&lt;br&gt;(no API calls)&lt;br&gt;&lt;br&gt;&lt;i style=&quot;color:#b8d4ef&quot;&gt;(Runs in user&#39;s Browser)&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="80" y="310" as="geometry" />
        </mxCell>
        <mxCell id="mobile" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0a4680;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;Mobile Application&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#cfe1f5&quot;&gt;[Container: Kotlin + Jetpack Compose]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Native Android app with the same customer features&lt;br&gt;as the web app, including zip-code auto-fill&lt;br&gt;(no admin pages)&lt;br&gt;&lt;br&gt;&lt;i style=&quot;color:#b8d4ef&quot;&gt;(Runs on Android device)&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="580" y="310" as="geometry" />
        </mxCell>
        <mxCell id="backend" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;Backend API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#d2ecdd&quot;&gt;[Container: Node.js + Express.js]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Single shared REST API used by both web and mobile.&lt;br&gt;Login checks the bcrypt password hash but issues no token;&lt;br&gt;later routes trust the userId the client sends&lt;br&gt;(:userId in the URL or in the body; no auth check).&lt;br&gt;Shipments, tracking, payment records,&lt;br&gt;notifications, activity log&lt;br&gt;&lt;br&gt;&lt;i style=&quot;color:#c0dcce&quot;&gt;(Deployed on Render Cloud — Free Tier)&lt;/i&gt;" vertex="1">
          <mxGeometry height="190" width="480" x="260" y="570" as="geometry" />
        </mxCell>
        <mxCell id="database" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438dd5;strokeColor=#1e5e99;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;PostgreSQL Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#d4e7f8&quot;&gt;[Container: PostgreSQL 18]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Stores users, shipments, payments,&lt;br&gt;notifications, activity log (5 tables)&lt;br&gt;&lt;br&gt;&lt;i style=&quot;color:#bcd8ef&quot;&gt;(Deployed on Render Cloud)&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="350" x="325" y="830" as="geometry" />
        </mxCell>
