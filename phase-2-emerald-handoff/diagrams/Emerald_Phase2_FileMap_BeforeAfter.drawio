        <mxCell id="u10_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ededed;strokeColor=#8b8b8b;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;UNCHANGED:&lt;/b&gt; Standard git ignore rules and project README." vertex="1">
          <mxGeometry height="60" width="1370" x="300" y="3235" as="geometry" />
        </mxCell>
        <mxCell id="s8_hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5a8c;strokeColor=#6b3f6c;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;spacingLeft=15;" value="8. SonarCloud — What It MEASURES vs What CONTROLS It" vertex="1">
          <mxGeometry height="32" width="1640" x="30" y="3325" as="geometry" />
        </mxCell>
        <mxCell id="s8_explain" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontColor=#555555;fontStyle=2;" value="My SonarCloud project: &lt;b&gt;FantasticRattee_2025-ITCS383-Arai-Kor-Dai&lt;/b&gt; (org: &lt;b&gt;fantasticrattee&lt;/b&gt;) — scans the WEB+BACKEND repo only. The Android repo is separate and has no SonarCloud project under my account." vertex="1">
          <mxGeometry height="24" width="1640" x="30" y="3360" as="geometry" />
        </mxCell>
        <mxCell id="s8_left_hdr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" value="&lt;b&gt;🔍 What SonarCloud MEASURES&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;(the files being analyzed)&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="810" x="30" y="3395" as="geometry" />
        </mxCell>
        <mxCell id="s8_left_static" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f8f4;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b&gt;Static analysis (bugs, smells, security):&lt;/b&gt; ALL 8.8k lines in &lt;b&gt;implementations/&lt;/b&gt;&lt;br&gt;• React frontend pages (JSX)&lt;br&gt;• Backend routes + server.js + db.js&lt;br&gt;• SQL schema (setup.sql)" vertex="1">
          <mxGeometry height="100" width="810" x="30" y="3460" as="geometry" />
        </mxCell>
        <mxCell id="s8_left_cov" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f8f4;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b&gt;Coverage measurement (only where tests run):&lt;/b&gt;&lt;br&gt;&lt;b&gt;routes/users.js&lt;/b&gt; …………………… 100%&lt;br&gt;&lt;b&gt;routes/shipments.js&lt;/b&gt; ………… 97.9%&lt;br&gt;&lt;b&gt;routes/notifications.js&lt;/b&gt; 100%&lt;br&gt;&lt;b&gt;routes/activity.js&lt;/b&gt; …………… 100%&lt;br&gt;&lt;b&gt;Overall: 99.0%&lt;/b&gt;" vertex="1">
          <mxGeometry height="140" width="810" x="30" y="3570" as="geometry" />
        </mxCell>
        <mxCell id="s8_right_hdr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" value="&lt;b&gt;⚙️ What CONTROLS SonarCloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;(files that configure and trigger it)&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="810" x="860" y="3395" as="geometry" />
        </mxCell>
        <mxCell id="s8_right_files" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6fc;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b&gt;In the repo:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;.github/workflows/ci.yml&lt;/b&gt; — triggers the scan on every push / PR&lt;br&gt;• &lt;b&gt;sonar-project.properties&lt;/b&gt; — sets project key, org, sources, coverage exclusions&lt;br&gt;• &lt;b&gt;implementations/backend/jest.config.js&lt;/b&gt; — produces &lt;b&gt;coverage/lcov.info&lt;/b&gt; that SonarCloud reads" vertex="1">
          <mxGeometry height="100" width="810" x="860" y="3460" as="geometry" />
        </mxCell>
        <mxCell id="s8_right_secrets" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6fc;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b&gt;GitHub Secrets (repo Settings → Actions):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;SONAR_TOKEN&lt;/b&gt; — authenticates CI against my SonarCloud project&lt;br&gt;• &lt;b&gt;DATABASE_URL&lt;/b&gt; — lets Jest tests connect to Render PostgreSQL (to generate real coverage)&lt;br&gt;&lt;br&gt;&lt;b&gt;SonarCloud dashboard settings:&lt;/b&gt;&lt;br&gt;• Quality Gate = Sonar way&lt;br&gt;• New Code = &quot;Previous version&quot;&lt;br&gt;• Automatic Analysis = OFF (CI-driven only)" vertex="1">
          <mxGeometry height="140" width="810" x="860" y="3570" as="geometry" />
        </mxCell>
        <mxCell id="s8_notcov" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#e09a3a;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;❌ What SonarCloud does NOT cover:&lt;/b&gt; Android repo (separate codebase — would need its own SonarCloud project) &amp;nbsp;|&amp;nbsp; Render deployment config (infrastructure, not code) &amp;nbsp;|&amp;nbsp; PostgreSQL runtime data (only the schema file setup.sql is analyzed)." vertex="1">
          <mxGeometry height="48" width="1640" x="30" y="3725" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=2;fontColor=#555555;" value="&lt;b&gt;Summary:&lt;/b&gt; 8 files TOUCHED &amp;nbsp;|&amp;nbsp; ~24 files ADDED (tests, CI, diagrams, entire Android repo) &amp;nbsp;|&amp;nbsp; ~14 files/folders UNCHANGED &amp;nbsp;|&amp;nbsp; SonarCloud measures coverage on 4 route files only = &lt;b&gt;99.0%&lt;/b&gt;" vertex="1">
          <mxGeometry height="36" width="1640" x="30" y="3795" as="geometry" />
        </mxCell>
        <mxCell id="gsTMg2d1fqm9uM3Bdmfx-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="850" width="1307.71" x="40" y="3890" as="geometry" />
        </mxCell>
