        </mxCell>
        <mxCell id="f3_after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Same as before &lt;b&gt;PLUS&lt;/b&gt;: added &lt;b&gt;initDB()&lt;/b&gt; that runs CREATE TABLE IF NOT EXISTS on startup; exports &lt;b&gt;module.exports = app&lt;/b&gt; so Supertest can run tests; only calls &lt;b&gt;listen()&lt;/b&gt; if run directly." vertex="1">
          <mxGeometry height="70" width="720" x="950" y="370" as="geometry" />
        </mxCell>
        <mxCell id="f4_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e09a3a;strokeColor=#8a5720;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;package.json&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#e0e0e0&quot;&gt;Dependencies&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="160" x="30" y="450" as="geometry" />
        </mxCell>
        <mxCell id="f4_before" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Had &lt;b&gt;mysql2&lt;/b&gt;, express, cors, bcrypt, etc. Test script was &lt;b&gt;&quot;echo Error: no test specified&quot;&lt;/b&gt; (stub that exits with error 1). No dev dependencies." vertex="1">
