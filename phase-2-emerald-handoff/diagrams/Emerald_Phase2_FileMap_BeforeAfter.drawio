          <mxGeometry height="50" width="260" x="30" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="n3_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; 6 tests — list notifications, ordering, 10-item limit, mark-all-as-read, empty-user handling." vertex="1">
          <mxGeometry height="50" width="1370" x="300" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="n4_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;__tests__/activity.test.js&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="30" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="n4_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; 4 tests — list activity, ordering by created_at, 10-item limit, empty-user handling." vertex="1">
          <mxGeometry height="50" width="1370" x="300" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="n5_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;__tests__/error-handling.test.js&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="30" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="n5_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; 13 tests using &lt;b&gt;jest.mock(&#39;../db&#39;)&lt;/b&gt; to force DB failures and cover every catch block (return 500 + error message). Boosts coverage from 88.8% → 99.0%." vertex="1">
          <mxGeometry height="50" width="1370" x="300" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="n6_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;jest.config.js&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="30" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="n6_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; Jest config: &lt;b&gt;testEnvironment: node&lt;/b&gt;, coverage from &lt;b&gt;routes/**/*.js&lt;/b&gt; only, lcov + clover + text reporters, &lt;b&gt;maxWorkers: 1 + isolateModules: true&lt;/b&gt; to prevent mock leakage." vertex="1">
          <mxGeometry height="50" width="1370" x="300" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="n7_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;run-setup.js&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="30" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="n7_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; Standalone Node script to run setup.sql against Render DB once (before initDB was added to server.js). Kept as a manual fallback; not used in production." vertex="1">
          <mxGeometry height="50" width="1370" x="300" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="s4_hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5a8c;strokeColor=#6b3f6c;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;spacingLeft=15;" value="4. Web Frontend (implementations/frontend/src/Pages/)" vertex="1">
          <mxGeometry height="32" width="1640" x="30" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="w1_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e09a3a;strokeColor=#8a5720;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;LoginPage.jsx&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="160" x="30" y="1435" as="geometry" />
        </mxCell>
        <mxCell id="w1_before" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;FAKE LOGIN&lt;/b&gt; — just called &lt;b&gt;setTimeout(() =&gt; navigate(&#39;/dashboard&#39;), 1200)&lt;/b&gt;. No API call. No credentials validated. No userId set anywhere." vertex="1">
          <mxGeometry height="70" width="700" x="210" y="1435" as="geometry" />
        </mxCell>
        <mxCell id="w1_arrow" parent="1" style="text;html=1;align=center;fontSize=24;fontColor=#1168bd;fontStyle=1;" value="→" vertex="1">
          <mxGeometry height="30" width="30" x="915" y="1453" as="geometry" />
        </mxCell>
        <mxCell id="w1_after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;REAL LOGIN&lt;/b&gt; — calls &lt;b&gt;fetch(${API_URL}/users/login)&lt;/b&gt; with email+password, handles 401/500, stores &lt;b&gt;userId/userName/userEmail/userRole&lt;/b&gt; in localStorage before redirecting. Dashboard now loads real data." vertex="1">
          <mxGeometry height="70" width="720" x="950" y="1435" as="geometry" />
        </mxCell>
        <mxCell id="w2_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e09a3a;strokeColor=#8a5720;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;CreateShipmentPage.jsx&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="160" x="30" y="1515" as="geometry" />
        </mxCell>
