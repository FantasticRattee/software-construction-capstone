        <mxCell id="w3_after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Each page now falls back to &lt;b&gt;https://two025-itcs383-arai-kor-dai-cyio.onrender.com/api&lt;/b&gt; so the deployed app hits the cloud backend instead of localhost. No other logic changes." vertex="1">
          <mxGeometry height="100" width="720" x="950" y="1595" as="geometry" />
