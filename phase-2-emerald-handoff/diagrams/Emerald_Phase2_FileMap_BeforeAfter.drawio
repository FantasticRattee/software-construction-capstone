        <mxCell id="r1_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e09a3a;strokeColor=#8a5720;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;users.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#e0e0e0&quot;&gt;Auth + profile&lt;/span&gt;" vertex="1">
