        <mxCell id="f1_before" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Used &lt;b&gt;mysql2/promise&lt;/b&gt; package. Connected to local MySQL via host/port/user/password from .env. Exported connection pool." vertex="1">
          <mxGeometry height="70" width="700" x="210" y="210" as="geometry" />
        </mxCell>
        <mxCell id="f1_arrow" parent="1" style="text;html=1;align=center;fontSize=24;fontColor=#1168bd;fontStyle=1;" value="→" vertex="1">
