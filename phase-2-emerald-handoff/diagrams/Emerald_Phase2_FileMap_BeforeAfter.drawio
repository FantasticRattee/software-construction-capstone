          <mxGeometry height="70" width="700" x="210" y="1515" as="geometry" />
        </mxCell>
        <mxCell id="w2_arrow" parent="1" style="text;html=1;align=center;fontSize=24;fontColor=#1168bd;fontStyle=1;" value="→" vertex="1">
