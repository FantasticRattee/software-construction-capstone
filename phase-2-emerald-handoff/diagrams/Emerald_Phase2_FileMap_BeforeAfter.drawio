        <mxCell id="r2_before" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="MySQL queries. Endpoints: POST /, GET /recent, /track/:id, /monthly/:id, /history/:id, /:userId. Transactions used &lt;b&gt;beginTransaction / commit / rollback&lt;/b&gt; on a connection." vertex="1">
