        <mxCell id="c2_after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Retired — now a placeholder that says &quot;use ci.yml instead.&quot; Still there to avoid breaking anything that referenced it." vertex="1">
