        <mxCell id="r1_before" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="MySQL queries with &lt;b&gt;?&lt;/b&gt; placeholders, &lt;b&gt;[rows]&lt;/b&gt; destructuring. Endpoints: POST /register, /login, GET /profile/:id, /stats/:id. Used bcrypt." vertex="1">
          <mxGeometry height="70" width="700" x="210" y="585" as="geometry" />
        </mxCell>
