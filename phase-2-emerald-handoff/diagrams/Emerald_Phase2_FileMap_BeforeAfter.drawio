        <mxCell id="w2_after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Added &lt;b&gt;PREFIX_TO_PROVINCE&lt;/b&gt; lookup — when user types a 5-digit Thai postal code, province auto-fills with green feedback. Covers all 77 Thai provinces. Submit posts to Render URL." vertex="1">
          <mxGeometry height="70" width="720" x="950" y="1515" as="geometry" />
        </mxCell>
