        <mxCell id="f3_before" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Created Express app, mounted 4 route groups under /api/*, set up CORS and JSON middleware, called &lt;b&gt;app.listen(PORT)&lt;/b&gt;." vertex="1">
          <mxGeometry height="70" width="700" x="210" y="370" as="geometry" />
