        </mxCell>
        <mxCell id="f4_after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Replaced &lt;b&gt;mysql2&lt;/b&gt; with &lt;b&gt;pg&lt;/b&gt;. Added devDependencies: &lt;b&gt;jest&lt;/b&gt;, &lt;b&gt;supertest&lt;/b&gt;. Added real test scripts: &lt;b&gt;&quot;test&quot;&lt;/b&gt; and &lt;b&gt;&quot;test:ci&quot;&lt;/b&gt; with &lt;b&gt;--coverage&lt;/b&gt;." vertex="1">
