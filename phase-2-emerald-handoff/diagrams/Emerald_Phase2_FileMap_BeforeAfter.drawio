        <mxCell id="u10_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8b8b8b;strokeColor=#5f5f5f;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;.gitignore&lt;/b&gt;&lt;br&gt;&lt;b&gt;README.md&lt;/b&gt; (top-level)" vertex="1">
