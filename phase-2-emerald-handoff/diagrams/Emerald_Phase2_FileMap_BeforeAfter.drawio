        <mxCell id="w3_before" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Each page had &lt;b&gt;const API_URL = process.env.REACT_APP_API_URL || &quot;http://localhost:3000/api&quot;&lt;/b&gt; at the top. All fetches went to localhost in dev." vertex="1">
          <mxGeometry height="100" width="700" x="210" y="1595" as="geometry" />
