        <mxCell id="s5_hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;spacingLeft=15;" value="5. CI / Quality Configuration" vertex="1">
          <mxGeometry height="32" width="1640" x="30" y="1715" as="geometry" />
        </mxCell>
        <mxCell id="c1_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;.github/workflows/ci.yml&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="30" y="1760" as="geometry" />
