        </mxCell>
        <mxCell id="r1_after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Same endpoints, same business logic. Converted to PostgreSQL: &lt;b&gt;$1, $2&lt;/b&gt; placeholders, &lt;b&gt;result.rows&lt;/b&gt;, &lt;b&gt;SUM(CASE WHEN...)&lt;/b&gt; instead of boolean SUM, &lt;b&gt;RETURNING id&lt;/b&gt; instead of insertId. &lt;b&gt;100% coverage&lt;/b&gt;." vertex="1">
          <mxGeometry height="70" width="720" x="950" y="585" as="geometry" />
        </mxCell>
