        <mxCell id="c1_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; 3-job pipeline that runs on every push to &lt;b&gt;master&lt;/b&gt;/&lt;b&gt;Phrase-2&lt;/b&gt; — Job 1 runs Jest tests with coverage, Job 2 builds frontend, Job 3 uploads coverage to SonarCloud." vertex="1">
          <mxGeometry height="50" width="1370" x="300" y="1760" as="geometry" />
        </mxCell>
