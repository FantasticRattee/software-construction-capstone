        </mxCell>
        <mxCell id="f1_after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Uses &lt;b&gt;pg&lt;/b&gt; package. Connects to Render PostgreSQL via &lt;b&gt;DATABASE_URL&lt;/b&gt; env var with SSL. Exports &lt;b&gt;pg.Pool&lt;/b&gt; for all routes." vertex="1">
          <mxGeometry height="70" width="720" x="950" y="210" as="geometry" />
        </mxCell>
        <mxCell id="f2_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e09a3a;strokeColor=#8a5720;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;setup.sql&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#e0e0e0&quot;&gt;DB schema&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="160" x="30" y="290" as="geometry" />
        </mxCell>
        <mxCell id="f2_before" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="MySQL dialect: backticks for identifiers, &lt;b&gt;AUTO_INCREMENT&lt;/b&gt;, &lt;b&gt;TINYINT&lt;/b&gt;, &lt;b&gt;DATETIME DEFAULT CURRENT_TIMESTAMP&lt;/b&gt;. 5 tables: users, shipments, payments, notifications, activity_log." vertex="1">
          <mxGeometry height="70" width="700" x="210" y="290" as="geometry" />
        </mxCell>
        <mxCell id="f2_arrow" parent="1" style="text;html=1;align=center;fontSize=24;fontColor=#1168bd;fontStyle=1;" value="→" vertex="1">
          <mxGeometry height="30" width="30" x="915" y="308" as="geometry" />
        </mxCell>
        <mxCell id="f2_after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="PostgreSQL dialect: &lt;b&gt;SERIAL&lt;/b&gt; instead of AUTO_INCREMENT, &lt;b&gt;SMALLINT&lt;/b&gt; instead of TINYINT, no backticks, &lt;b&gt;CASCADE&lt;/b&gt; on DROP. Same 5-table schema." vertex="1">
          <mxGeometry height="70" width="720" x="950" y="290" as="geometry" />
        </mxCell>
        <mxCell id="f3_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e09a3a;strokeColor=#8a5720;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;server.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#e0e0e0&quot;&gt;App entry point&lt;/span&gt;" vertex="1">
