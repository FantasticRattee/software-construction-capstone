          <mxGeometry height="80" width="260" x="30" y="1890" as="geometry" />
        </mxCell>
        <mxCell id="c3_before" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#888888;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Config pointed at old project key/org. &lt;b&gt;sonar.coverage.exclusions=**/*&lt;/b&gt; — effectively hid the fact there was 0% test coverage." vertex="1">
          <mxGeometry height="80" width="625" x="300" y="1890" as="geometry" />
        </mxCell>
        <mxCell id="c3_arrow" parent="1" style="text;html=1;align=center;fontSize=20;fontColor=#1168bd;fontStyle=1;" value="→" vertex="1">
          <mxGeometry height="25" width="25" x="930" y="1920" as="geometry" />
        </mxCell>
        <mxCell id="c3_after" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#2d8659;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="Now points at my own project/org. Coverage is measured properly from &lt;b&gt;coverage/lcov.info&lt;/b&gt; with narrow exclusions (only frontend + infrastructure files). Reports &lt;b&gt;99% on routes/&lt;/b&gt;." vertex="1">
          <mxGeometry height="80" width="710" x="960" y="1890" as="geometry" />
        </mxCell>
        <mxCell id="s6_hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;spacingLeft=15;" value="6. Android Mobile App (NEW repo: 2025-ITCS383-Emerald-Android)" vertex="1">
          <mxGeometry height="32" width="1640" x="30" y="1985" as="geometry" />
        </mxCell>
        <mxCell id="a1_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;app/build.gradle.kts&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="30" y="2030" as="geometry" />
        </mxCell>
        <mxCell id="a1_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; Kotlin+Compose build config. Defines &lt;b&gt;BuildConfig.API_BASE_URL&lt;/b&gt; pointing at Render. Pulls in Retrofit, Gson, Compose, DataStore, Material 3." vertex="1">
          <mxGeometry height="50" width="1370" x="300" y="2030" as="geometry" />
        </mxCell>
        <mxCell id="a2_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;data/api/RetrofitClient.kt&lt;/b&gt;&lt;br&gt;&lt;b&gt;data/api/ApiService.kt&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="260" x="30" y="2090" as="geometry" />
        </mxCell>
        <mxCell id="a2_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; HTTP layer. RetrofitClient builds a singleton Retrofit instance pointing at BuildConfig.API_BASE_URL. ApiService declares every backend endpoint (@POST, @GET, @PATCH) with Kotlin data classes for request/response." vertex="1">
          <mxGeometry height="60" width="1370" x="300" y="2090" as="geometry" />
        </mxCell>
        <mxCell id="a3_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;data/SessionManager.kt&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="30" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="a3_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; DataStore-based session persistence. Saves userId/userName/userEmail/userRole after login and exposes them as Flow for screens to observe." vertex="1">
          <mxGeometry height="50" width="1370" x="300" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="a4_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;data/ThaiPostalCodes.kt&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="30" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="a4_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; Thai postal-code → province lookup (prefix-based, covers 77 provinces). Used by CreateShipmentScreen to auto-fill province when user types a 5-digit zip." vertex="1">
          <mxGeometry height="50" width="1370" x="300" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="a5_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;ui/screens/*.kt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#d2ecdd&quot;&gt;(9 screen files)&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="260" x="30" y="2280" as="geometry" />
        </mxCell>
        <mxCell id="a5_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; Login, Register, Dashboard, CreateShipment (w/ auto-fill), Payment (6 payment methods, card preview), ShippingLabel (Thailand Post label + barcode), Tracking, History (tap-to-copy), Settings — all built with Jetpack Compose, wired via AppNavigation.kt, call ApiService, persist session through SessionManager." vertex="1">
          <mxGeometry height="60" width="1370" x="300" y="2280" as="geometry" />
        </mxCell>
        <mxCell id="a6_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;MainActivity.kt&lt;/b&gt;&lt;br&gt;&lt;b&gt;AndroidManifest.xml&lt;/b&gt;&lt;br&gt;&lt;b&gt;ui/theme/*.kt&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="260" x="30" y="2350" as="geometry" />
        </mxCell>
        <mxCell id="a6_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; App entry. MainActivity.kt bootstraps the Compose UI and session. AndroidManifest.xml declares activities + INTERNET permission + usesCleartextTraffic=true. Theme files (Color.kt, Theme.kt, Type.kt) set Thailand-Post-red branding (#E60012) and Material 3 colors." vertex="1">
          <mxGeometry height="70" width="1370" x="300" y="2350" as="geometry" />
        </mxCell>
        <mxCell id="a7_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;navigation/AppNavigation.kt&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="30" y="2430" as="geometry" />
        </mxCell>
        <mxCell id="a7_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#1168bd;fontColor=#1a1a2e;fontSize=11;align=left;verticalAlign=middle;arcSize=6;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;NEW:&lt;/b&gt; Navigation-Compose route graph (login, register, dashboard, create_shipment, payment/{amount}/{data}, shipping_label/{track}/{data}, tracking, history, settings). Handles URL-encoded parameters between screens." vertex="1">
          <mxGeometry height="50" width="1370" x="300" y="2430" as="geometry" />
        </mxCell>
        <mxCell id="a8_name" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d8659;strokeColor=#1d5e3d;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;arcSize=6;" value="&lt;b&gt;data/model/*.kt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#d2ecdd&quot;&gt;(User, Shipment, Notification, requests/responses)&lt;/span&gt;" vertex="1">
